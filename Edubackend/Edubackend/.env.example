# Puerto de la base de datos y credenciales
DB_URL=jdbc:postgresql://localhost:5432/edubaka_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Secret para firmar los tokens (debe ser una cadena larga y segura)
JWT_SECRET=tu_secreto_jwt_super_seguro_y_largo_para_edubaka_2024

# URL del Frontend (para redirecciones de OAuth2 y CORS)
FRONTEND_URL=http://localhost:5173

# Google OAuth2 Credentials (obtener de Google Cloud Console)
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui

# Gemini API Key (gratis en https://aistudio.google.com/apikey) - sin esto el chat responde "no configurado"
GEMINI_API_KEY=

# Máximo de mensajes de chat por usuario por día (protege la cuota gratuita)
CHAT_DAILY_LIMIT=30
